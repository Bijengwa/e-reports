NODE_ENV=development
LOG_LEVEL=debug

HOST=127.0.0.1

PORT=3100

PUBLIC_HOST=public.localhost:3100
STAFF_HOST=staff.localhost:3100

DATABASE_URL=postgres://ereports:ereports@localhost:5432/ereports_dev

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

STORAGE_DRIVER=filesystem
STORAGE_ROOT=./var/storage
EMAIL_DRIVER=console
SMS_DRIVER=console

TEST_OWNER_DATABASE_URL=postgres://<owner>:<password>@localhost:5432/ereports_test

TEST_DATABASE_URL=postgres://<owner>:<password>@localhost:5432/ereports_test

TEST_APP_DATABASE_URL=postgres://ereports_app:<password>@localhost:5432/ereports_test

# Render free tier only: requested every 5 minutes so the host does not put the service to sleep
# after 15 idle minutes. Leave unset anywhere the server stays up on its own.
# KEEP_ALIVE_URL=https://<STAFF_HOST>/healthz

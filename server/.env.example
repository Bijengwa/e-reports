# Copy to .env and adjust. Every value here is parsed through Zod at boot —
# an invalid or missing value crashes the process before it listens.

NODE_ENV=development
LOG_LEVEL=debug

HOST=127.0.0.1
# Port 3000 is already occupied on this development machine by an unrelated service,
# so the default here avoids the collision. Change freely — but keep the two
# *_HOST values below in sync, because they must match the Host header exactly.
PORT=3100

# The two doors. Values must match the Host header exactly, port included.
# *.localhost resolves to 127.0.0.1, which gives real host separation in development.
PUBLIC_HOST=public.localhost:3100
STAFF_HOST=staff.localhost:3100

# Local development uses the natively installed PostgreSQL 18.
DATABASE_URL=postgres://ereports:ereports@localhost:5432/ereports_dev

# Session lifetimes for the staff door.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Adapters. Local development uses the console/filesystem implementations
# so that no Docker, MinIO or SMTP server is required.
STORAGE_DRIVER=filesystem
STORAGE_ROOT=./var/storage
EMAIL_DRIVER=console
SMS_DRIVER=console

# --- Integration tests -------------------------------------------------------
#
# `pnpm test` skips the database-backed cases when these are absent, so it stays
# green anywhere. `pnpm test:integration` fails closed without them, so a CI run
# with no database cannot pass by quietly skipping the concurrency case.
#
# Two connections, because they prove different things. The owner applies
# migrations and truncates -- audit_log revokes TRUNCATE from the application
# role, and its trigger blocks DELETE for everyone. The application role runs the
# commands under test, so a missing GRANT fails here rather than in the container.
#
# The database name must end in _test, and TEST_DATABASE_URL must differ from
# DATABASE_URL. The harness refuses to run otherwise: it truncates three tables
# and takes a per-database advisory lock.

# Used to apply migrations to the test database. May be the same value as
# TEST_DATABASE_URL. Needs CREATE ROLE the first time, for migration 0003.
TEST_OWNER_DATABASE_URL=postgres://<owner>:<password>@localhost:5432/ereports_test

# Owner connection used by the harness itself.
TEST_DATABASE_URL=postgres://<owner>:<password>@localhost:5432/ereports_test

# The restricted role created by migration 0003. Its password is set outside the
# migration: ALTER ROLE ereports_app PASSWORD '<password>';
TEST_APP_DATABASE_URL=postgres://ereports_app:<password>@localhost:5432/ereports_test

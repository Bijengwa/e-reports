# Copy to .env and adjust. Every value here is parsed through Zod at boot —
# an invalid or missing value crashes the process before it listens.

NODE_ENV=development
LOG_LEVEL=debug

HOST=127.0.0.1
# Port 3000 is already occupied on this development machine by an unrelated service,
# so the default here avoids the collision. Change freely — but keep the two
# *_HOST values below in sync, because they must match the Host header exactly.
PORT=3100

# The two doors. Values must match the Host header exactly, port included.
# *.localhost resolves to 127.0.0.1, which gives real host separation in development.
PUBLIC_HOST=public.localhost:3100
STAFF_HOST=staff.localhost:3100

# Local development uses the natively installed PostgreSQL 18.
DATABASE_URL=postgres://ereports:ereports@localhost:5432/ereports_dev

# Session lifetimes for the staff door.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Adapters. Local development uses the console/filesystem implementations
# so that no Docker, MinIO or SMTP server is required.
STORAGE_DRIVER=filesystem
STORAGE_ROOT=./var/storage
EMAIL_DRIVER=console
SMS_DRIVER=console
